---
import Base from '../layouts/Base.astro';
import BenchPanel from '../components/BenchPanel.astro';
const localArt = (name: string) => `/img/bench/paper/${name}.webp`;
const sports = [
  { class: 'dumbbells', asset: 'dumbbells', label: 'Pair of dumbbells', width: 560, height: 370 },
  { class: 'football', asset: 'football', label: 'Football', width: 330, height: 330 },
  { class: 'helmet', asset: 'helmet', label: 'Motorcycle helmet', width: 512, height: 512 },
  { class: 'volleyball', asset: 'volleyball', label: 'Volleyball', width: 330, height: 330 },
  { class: 'shuttle', asset: 'shuttle', label: 'Badminton shuttlecock', width: 210, height: 340 },
  { class: 'knight', asset: 'knight', label: 'Chess knight', width: 220, height: 350 },
  { class: 'paddles', asset: 'paddles', label: 'Table-tennis paddle', width: 360, height: 360 },
];
---

<Base title="Kartik Tagore — a few things I'm into" description="Kartik Tagore. Second-year student at VJTI, Mumbai. Robotics, gym, and whatever game is going." bench>
  <section class="workbench" tabindex="0" aria-label="Kartik's scrapbook" aria-describedby="scene-instructions">
    <p id="scene-instructions" class="sr-only">On desktop, use the up and down arrow keys to rearrange the objects. The reset button returns them to their starting positions.</p>
    <svg class="bench-wires" viewBox="0 0 1440 780" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <path d="M35 285C150 235 241 218 216 303S84 391 174 447" stroke="#40473e" stroke-width="3" />
      <path d="M43 297C160 246 254 231 229 310S99 402 184 455" stroke="#a65340" stroke-width="2.5" />
    </svg>

    <div class="bench-intro">
      <h1><span class="intro-line"><span data-greeting>Hi</span>, I'm Kartik Tagore</span> <span class="intro-line">and I'm into <span class="ink-word" aria-label="building">{Array.from('building').map((letter, i) => <span class="ink-letter" style={`--letter:${i}`}>{letter}</span>)}<svg viewBox="0 0 160 14" aria-hidden="true"><path d="M3 8Q66 -2 155 5M10 12Q85 3 147 10" /></svg></span> things</span></h1>
      <p class="intro-small">Hardware, software, and making things work. When they don't, I like figuring out why.</p>
      <p class="intro-small">I'm a second-year student at VJTI, building with <a href="https://sravjti.in/" target="_blank" rel="noopener noreferrer">SRA</a> in Mumbai while trying to live life out, one moment at a time :)</p>

    </div>

    {sports.map((sport) => (
      <a class:list={['bench-object', 'sport-object', sport.class]} data-prop={sport.class} href="#away" data-panel="away" data-interest={sport.class} aria-label={`${sport.label} — away from the bench`}>
        <span class="cut-paper"><img src={localArt(sport.asset)} width={sport.width} height={sport.height} alt={sport.label} /></span>
      </a>
    ))}

    <a class="bench-object screwdriver" data-prop="screwdriver" href="#away" data-panel="away" data-interest="screwdriver" aria-label="Screwdriver — a little about me">
      <span class="cut-paper"><img src={localArt('screwdriver')} width="512" height="512" alt="Red-handled screwdriver." /></span>
    </a>

    <a class="bench-object jetson" data-prop="jetson" href="#away" data-panel="away" data-interest="jetson" aria-label="Jetson — a little about me">
      <span class="cut-paper"><img src={localArt("jetson-render")} width="910" height="634" alt="Supplied render of a Jetson Nano development board." /></span>
    </a>

    <a class="bench-object car-object" data-prop="car" id="work" href="https://blog.sravjti.in/2026/10/20/mcqueen.html" aria-label="McQueen — read the SRA build story" target="_blank" rel="noopener noreferrer">
      <span class="cut-paper"><img src={localArt('mcqueen')} width="390" height="285" alt="McQueen, our red RC car converted for vision-based autonomous driving." fetchpriority="high" /></span>
      <span class="object-label"><span>McQueen</span><span aria-hidden="true">↗</span></span>
      <span class="object-caption">An RC car we turned autonomous.</span>
    </a>

    <div class="bench-object uno" data-prop="uno" role="group" aria-label="Arduino UNO interactive artwork">
      <a class="uno-info" href="#away" data-panel="away" data-interest="uno" aria-label="Arduino — a little about me"><span class="cut-paper"><img class="uno-art" src={localArt("arduino-uno")} width="285" height="209" alt="Arduino UNO development board." /></span></a>
      <div class="uno-controls" hidden>
        <button class="uno-connector" aria-label="UNO connector" aria-pressed="false"></button>
        <button class="uno-power" aria-label="UNO power control"></button>
        <span class="uno-led" aria-hidden="true"></span>
        <span class="uno-scorch" aria-hidden="true"></span>
        <span class="uno-spark" aria-hidden="true"></span>
        <span class="uno-smoke" aria-hidden="true"></span>
        <span class="uno-aside" aria-hidden="true">sonny...</span>
        <button class="uno-reset" aria-label="Reset illustrated UNO" hidden>↶</button>
      </div>
      <span class="sr-only uno-status" role="status"></span>
    </div>

    <a class="bench-object notebook" data-prop="notebook" href="#now" data-panel="now" aria-label="Open Now — what's on my desk">
      <span class="notebook-cover" aria-hidden="true"></span>
      <span class="notebook-page">
        <span class="notebook-heading">a work in progress</span>
        <span class="notebook-date">currently,</span>
        <strong>A few projects.<br />A lot to learn.</strong>
        <span class="notebook-bottom">Now <span aria-hidden="true">↗</span></span>
      </span>
    </a>

    <span class="bench-marginalia marginalia-left" data-note="after" data-points-to="dumbbells football helmet" aria-hidden="true"><span>after class, find me here</span></span>
    <span class="bench-marginalia marginalia-right" data-note="progress" data-points-to="notebook" aria-hidden="true"><span>work in progress</span></span>
    <svg class="annotation-arrows" aria-hidden="true"><defs><marker id="pencil-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M1 1L9 5L1 9" /></marker></defs></svg>
    <div class="scene-caption" aria-hidden="true"><span>On & off the bench.</span><svg viewBox="0 0 70 35"><path d="M3 7Q34 -1 58 25M46 23L60 28L58 14" /></svg></div>
    <div class="scene-controls" hidden>
      <button class="rearrange" aria-label="Reset the arrangement"><span aria-hidden="true">↻</span></button>
    </div>
  </section>

  <div class="bench-notes">
    <BenchPanel id="now" title="What I'd like to explore">
      <ol><li>Open-source work.</li><li>Autonomous systems.</li><li>Robot learning.</li></ol>
      <a class="text-link" href="https://github.com/kt-fr" target="_blank" rel="noopener noreferrer">Follow along on GitHub ↗</a>
    </BenchPanel>
    <BenchPanel id="away" title="A little about me">
      <p class="handwritten">Hi, I'm Kartik Tagore.</p>
      <p>I'm a second-year student at VJTI, building with SRA in Mumbai. I like robots, hardware, software, and figuring out how things work.</p>
      <p>When I'm not building something, I'm probably at the gym, on the turf playing something like football or volleyball, out for a bike ride, playing chess, or taking a completely random walk.</p>
      <p class="interest-highlight" data-interest-note hidden aria-live="polite"></p>
    </BenchPanel>
  </div>
</Base>
